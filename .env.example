# Server
PORT=3000
NODE_ENV=production
ADMIN_PASSWORD=change-this-password
SESSION_SECRET=replace-with-a-long-random-secret

# IPTV provider: xtream or m3u
IPTV_PROVIDER=xtream
XTREAM_BASE_URL=https://provider.example
XTREAM_USERNAME=
XTREAM_PASSWORD=
M3U_URL=
EPG_URL=

# Optional metadata
TMDB_API_KEY=
SPORTSDB_API_KEY=

# Stream sharing
STREAM_IDLE_CLOSE_MS=10000
STREAM_MAX_BUFFER_BYTES=2097152
HLS_CACHE_MAX_BYTES=67108864
HLS_CACHE_TTL_MS=30000

# Ads
VAST_TAG_URL=
BANNER_HTML=
